@{
    ViewData["Title"] = "Accueil";
}

<div class="container">
    <h1 class="mt-3">Accueil — Volet 1</h1>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Créer une demande</h5>
                    <p class="card-text">Saisir titre, abstract et proposer ou choisir des journaux.</p>
                    <a asp-controller="Demandes" asp-action="Create" class="btn btn-primary">Créer</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Mes demandes</h5>
                    <p class="card-text">Consulter vos demandes, statuts et historique.</p>
                    <a asp-controller="Demandes" asp-action="MesDemandes" class="btn btn-primary">Voir mes demandes</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Demandes à valider</h5>
                    <p class="card-text">Pour validateurs : liste des demandes en attente.</p>
                    <a asp-controller="Validation" asp-action="Index" class="btn btn-primary">Consulter</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Modération</h5>
                    <p class="card-text">(Chef de Bureau) Groupes de propositions à fusionner.</p>
                    <a asp-controller="Moderation" asp-action="Index" class="btn btn-secondary">Modération</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Suivi éditeur</h5>
                    <p class="card-text">Déclarer la soumission réelle et consulter l'historique.</p>
                    <a asp-controller="SuiviEditeur" asp-action="Historique" class="btn btn-secondary" asp-route-demandeId="1">Historique (ex)</a>
                </div>
            </div>
        </div>
    </div>
</div>
