@model DashboardViewModel

@{
    ViewData["Title"] = "Tableau de bord";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Tableau de bord</h1>
        <p class="text-muted mb-0">
            État consolidé des demandes de publication.
        </p>
    </div>

    <small class="text-muted">
        Actualisé le
        @Model.DateGenerationUtc.ToString("dd/MM/yyyy HH:mm")
        UTC
    </small>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-primary">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Total des demandes
                </p>
                <p class="display-6 fw-bold text-primary mb-0">
                    @Model.NombreTotalDemandes
                </p>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-success">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Demandes autorisées
                </p>
                <p class="display-6 fw-bold text-success mb-0">
                    @Model.NombreDemandesAutorisees
                </p>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-info">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Articles publiés
                </p>
                <p class="display-6 fw-bold text-info mb-0">
                    @Model.NombreArticlesPublies
                </p>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 shadow-sm border-danger">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Anomalies ouvertes
                </p>

                <p class="display-6 fw-bold text-danger mb-2">
                    @Model.NombreAnomaliesOuvertes
                </p>

                <a asp-controller="Anomalies"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-danger">
                    Consulter les anomalies
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">
                    Statuts de validation interne
                </h2>
            </div>

            <ul class="list-group list-group-flush">
                @foreach (var statut in Model.StatutsInternes)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@statut.Libelle</span>

                        <span class="badge @statut.BadgeCss rounded-pill">
                            @statut.Nombre
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white">
                <h2 class="h5 mb-0">
                    Statuts éditeur
                </h2>
            </div>

            <ul class="list-group list-group-flush">
                @foreach (var statut in Model.StatutsEditeur)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@statut.Libelle</span>

                        <span class="badge @statut.BadgeCss rounded-pill">
                            @statut.Nombre
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h2 class="h5 mb-0">
            Répartition par laboratoire
        </h2>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Laboratoire</th>
                    <th>État</th>
                    <th class="text-center">Demandes</th>
                    <th class="text-center">Anomalies ouvertes</th>
                    <th class="text-center">Anomalies traitées</th>
                    <th class="text-center">Total anomalies</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Laboratoires.Count == 0)
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted py-4">
                            Aucun laboratoire à afficher.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var laboratoire in Model.Laboratoires)
                    {
                        <tr>
                            <td>
                                <strong>@laboratoire.Code</strong>
                            </td>

                            <td>@laboratoire.Nom</td>

                            <td>
                                <span class="badge @laboratoire.EtatBadgeCss">
                                    @laboratoire.EtatLibelle
                                </span>
                            </td>

                            <td class="text-center">
                                @laboratoire.NombreDemandes
                            </td>

                            <td class="text-center">
                                @if (laboratoire.NombreAnomaliesOuvertes > 0)
                                {
                                    <span class="badge bg-danger">
                                        @laboratoire.NombreAnomaliesOuvertes
                                    </span>
                                }
                                else
                                {
                                    <span>0</span>
                                }
                            </td>

                            <td class="text-center">
                                <span class="badge bg-success">
                                    @laboratoire.NombreAnomaliesTraitees
                                </span>
                            </td>

                            <td class="text-center fw-bold">
                                @laboratoire.NombreTotalAnomalies
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>